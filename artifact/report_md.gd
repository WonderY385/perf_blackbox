@tool
class_name BBReport
extends RefCounted
## C2a Markdown 报告：给人看（发 issue / 贴论坛 / 写 PR）。
## 结构固定，便于横向对比两个包。

const TIMELINE_POINTS := 24


static func build(pack: Dictionary, opts := {}) -> String:
	var lang := String(opts.get("lang", "zh"))
	var events: Array = pack.get("events", [])
	var deltas: Dictionary = pack.get("deltas", {})
	var manifest: Dictionary = pack.get("manifest", {})
	var out := PackedStringArray()

	out.append("# Perf Blackbox 性能事件报告")
	out.append("")
	if lang == "en":
		out.append("> Generated by Perf Blackbox %s · schema v%d · %d event(s)" % [
			BBSchema.TOOL_VERSION, int(pack.get("schema_version", 1)), events.size()])
	else:
		out.append("> 由 Perf Blackbox %s 生成 · schema v%d · 共 %d 个事件" % [
			BBSchema.TOOL_VERSION, int(pack.get("schema_version", 1)), events.size()])
	out.append("")

	if events.is_empty():
		out.append("## 结论")
		out.append("")
		out.append("本次录制**没有检测到掉帧事件**（阈值内的帧时间波动）。")
		out.append("这个包仍可作为场景基线使用：`frames.bin` 里有完整的逐帧数据。")
		out.append("")
		out.append(_env_section(pack))
		out.append(_diag_section(pack))
		return "\n".join(out)

	var worst: Dictionary = events[0]
	for ev in events:
		if float(ev.get("peak_ms", 0.0)) > float(worst.get("peak_ms", 0.0)):
			worst = ev
	var worst_delta: Dictionary = deltas.get(worst.get("id", ""), {})

	out.append("## TL;DR")
	out.append("")
	out.append("- 最严重事件 **%s**：峰值 **%.1f ms**（基线 %.1f ms，%.1f×，%s），发生在第 %d 帧" % [
		worst.get("id", "?"), float(worst.get("peak_ms", 0.0)), float(worst.get("baseline_ms", 0.0)),
		float(worst.get("ratio", 0.0)), String(worst.get("severity", "?")), int(worst.get("peak_frame", -1))])
	var root := String(worst_delta.get("root_cause", "inconclusive"))
	if root == "inconclusive":
		out.append("- 归因结论：**证据不足**（没有单一信号显著突出）→ 见下方「下一步实验」")
	else:
		out.append("- 最可能原因：**%s**（置信度 %.2f）" % [root, float(worst_delta.get("confidence", 0.0))])
	var tags: Array = worst.get("tags", [])
	if not tags.is_empty():
		out.append("- 自动标签：%s" % ", ".join(PackedStringArray(tags)))
	if worst.get("bookmark") != null:
		out.append("- 用户书签：`%s`" % String(worst.get("bookmark", "")))
	out.append("")

	out.append("## 事件表")
	out.append("")
	out.append("| id | 峰值帧 | 峰值 ms | 基线 ms | 倍数 | 分级 | 标签 | 归因 |")
	out.append("| --- | --- | --- | --- | --- | --- | --- | --- |")
	for ev in events:
		var d: Dictionary = deltas.get(ev.get("id", ""), {})
		out.append("| %s | %d | %.1f | %.1f | %.1f× | %s | %s | %s |" % [
			ev.get("id", "?"), int(ev.get("peak_frame", -1)), float(ev.get("peak_ms", 0.0)),
			float(ev.get("baseline_ms", 0.0)), float(ev.get("ratio", 0.0)), ev.get("severity", "?"),
			", ".join(PackedStringArray(ev.get("tags", []))) if not ev.get("tags", []).is_empty() else "-",
			String(d.get("root_cause", "inconclusive"))])
	out.append("")

	for ev in events:
		out.append_array(_event_section(pack, ev, deltas.get(ev.get("id", ""), {})))

	out.append("## 复现步骤")
	out.append("")
	out.append("1. 用同一个场景与设置启动游戏（本包记录的关键设置见下表，`settings_hash` 不同的包不可直接对比）。")
	out.append("2. 打开 Perf Blackbox，`BB.start_capture()` 开始录制。")
	out.append("3. 复现到第 %d 帧附近出现的操作（峰值帧）。" % int(worst.get("peak_frame", -1)))
	out.append("4. `BB.stop_capture()` → 导出 `.bhx`，与本包 `compare` 对比。")
	out.append("")
	out.append(_env_section(pack))
	out.append(_diag_section(pack))
	return "\n".join(out)


## 单事件的纯文本摘要（编辑器面板「原因」页用；不用 Markdown 表格）
static func build_event_digest(pack: Dictionary, ev: Dictionary, delta: Dictionary) -> String:
	var out := PackedStringArray()
	var win: Array = ev.get("window", [ev.get("start_frame", 0), ev.get("end_frame", 0)])
	var base_win: Array = ev.get("baseline_window", [0, 0])
	out.append("%s · 峰值 %.1f ms（基线 %.1f ms，%.1f×）· %s" % [
		String(ev.get("id", "?")), float(ev.get("peak_ms", 0.0)), float(ev.get("baseline_ms", 0.0)),
		float(ev.get("ratio", 0.0)), String(ev.get("severity", "?"))])
	var tags: Array = ev.get("tags", [])
	if not tags.is_empty():
		out.append("标签：%s" % ", ".join(PackedStringArray(tags)))
	if ev.get("bookmark") != null:
		out.append("书签：%s" % String(ev.get("bookmark", "")))
	out.append("窗口：f%d → f%d    基线：f%d → f%d" % [
		int(win[0]), int(win[1]), int(base_win[0]), int(base_win[1])])
	out.append("")
	out.append("时间线：%s" % _timeline(pack, int(win[0]), int(win[1]), int(ev.get("peak_frame", -1))))
	out.append("")

	out.append("归因结论：%s（置信度 %.2f）" % [
		String(delta.get("root_cause", "inconclusive")), float(delta.get("confidence", 0.0))])
	var ranked: Array = delta.get("ranking", [])
	if ranked.is_empty():
		out.append("（窗口内没有显著的新增信号——这通常意味着这一次卡顿不来自脚本/实体增量，"
			+ "而更可能是 GPU、shader 编译或外部抖动）")
	else:
		out.append("")
		out.append("候选（按可信度排序）：")
		for r in ranked:
			var ev_ids := ", ".join(PackedStringArray(r.get("evidence", [])))
			out.append("  %d. %s   score %.2f   [%s]   %s" % [
				int(r.get("rank", 0)), String(r.get("cause", "?")), float(r.get("score", 0.0)),
				ev_ids, "基线里已存在" if bool(r.get("baseline_present", false)) else "**新出现**"])
	var excluded: Array = delta.get("excluded", [])
	if not excluded.is_empty():
		out.append("")
		out.append("已排除（基线中一直存在，不是这次卡顿的原因）：")
		for x in excluded:
			out.append("  - %s：%s" % [String(x.get("cause", "?")), String(x.get("reason", ""))])
	var notes: Array = delta.get("notes", [])
	if not notes.is_empty():
		out.append("")
		out.append("说明：")
		for n in notes:
			out.append("  - %s" % String(n))
	return "\n".join(out)


static func _event_section(pack: Dictionary, ev: Dictionary, delta: Dictionary) -> PackedStringArray:
	var out := PackedStringArray()
	var win: Array = ev.get("window", [ev.get("start_frame", 0), ev.get("end_frame", 0)])
	var base_win: Array = ev.get("baseline_window", [0, 0])
	out.append("## 事件 %s" % ev.get("id", "?"))
	out.append("")
	out.append("- 窗口：帧 %d → %d（其中基线窗口 %d → %d）" % [int(win[0]), int(win[1]), int(base_win[0]), int(base_win[1])])
	out.append("- 峰值：%.1f ms（基线 %.1f ms，%.1f×，分级 **%s**）" % [
		float(ev.get("peak_ms", 0.0)), float(ev.get("baseline_ms", 0.0)),
		float(ev.get("ratio", 0.0)), ev.get("severity", "?")])
	out.append("- 时间线（抽稀）：`%s`" % _timeline(pack, int(win[0]), int(win[1]), int(ev.get("peak_frame", -1))))
	out.append("")

	var ranked: Array = delta.get("ranking", [])
	out.append("### 归因候选")
	out.append("")
	if ranked.is_empty():
		out.append("_没有候选达到显著阈值。_")
		out.append("")
	else:
		out.append("| # | 原因 | 分数 | 证据 | 基线中是否已存在 |")
		out.append("| --- | --- | --- | --- | --- |")
		for r in ranked:
			out.append("| %d | %s | %.2f | %s | %s |" % [
				int(r.get("rank", 0)), r.get("cause", "?"), float(r.get("score", 0.0)),
				", ".join(PackedStringArray(r.get("evidence", []))),
				"是" if bool(r.get("baseline_present", false)) else "**否（新出现）**"])
		out.append("")

	var excluded: Array = delta.get("excluded", [])
	if not excluded.is_empty():
		out.append("### 已排除")
		out.append("")
		for x in excluded:
			out.append("- `%s` —— %s" % [x.get("cause", "?"), x.get("reason", "")])
		out.append("")

	var notes: Array = delta.get("notes", [])
	if not notes.is_empty():
		out.append("### 说明")
		out.append("")
		for n in notes:
			out.append("- %s" % n)
		out.append("")

	out.append("### 原始增量（供核对）")
	out.append("")
	var scripts: Array = delta.get("scripts", [])
	if not scripts.is_empty():
		out.append("脚本探针：")
		for s in scripts:
			out.append("  - `%s` 调用 %d（基线 %d），首现 f%d，z=%.1f" % [
				s.get("id", "?"), int(s.get("calls", 0)), int(s.get("baseline_calls", 0)),
				int(s.get("first_seen_frame", -1)), float(s.get("z", 0.0))])
	var ents: Array = delta.get("entities", [])
	if not ents.is_empty():
		out.append("实体增量：")
		for e in ents:
			out.append("  - %s `%s` +%d，首现 f%d" % [e.get("kind", "?"), e.get("key", "?"), int(e.get("added", 0)), int(e.get("first_seen_frame", -1))])
	var counters: Array = delta.get("counters", [])
	if not counters.is_empty():
		out.append("计数器增量：")
		for c in counters:
			out.append("  - `%s` %.1f → %.1f（%+.1f），首变 f%d，z=%.1f" % [
				c.get("key", "?"), float(c.get("baseline", 0.0)), float(c.get("peak", 0.0)),
				float(c.get("delta", 0.0)), int(c.get("first_change_frame", -1)), float(c.get("z", 0.0))])
	if scripts.is_empty() and ents.is_empty() and counters.is_empty():
		out.append("_（本次没有可用增量数据）_")
	out.append("")
	return out


static func _timeline(pack: Dictionary, from_frame: int, to_frame: int, peak_frame: int) -> String:
	var series := _slice(pack, "frame_ms", from_frame, to_frame)
	if series.is_empty():
		return "(无逐帧数据)"
	var step := maxi(1, series.size() / TIMELINE_POINTS)
	var parts := PackedStringArray()
	for i in range(0, series.size(), step):
		var v := series[i]
		if v < 0.0:
			continue
		var marker := "*" if from_frame + i == peak_frame else ""
		parts.append("f%d:%.1f%s" % [from_frame + i, v, marker])
	return " ".join(parts)


static func _slice(pack: Dictionary, col_name: String, from_frame: int, to_frame: int) -> PackedFloat64Array:
	var data: Dictionary = pack.get("data", {})
	if not data.has(col_name):
		return PackedFloat64Array()
	var col: PackedFloat64Array = data[col_name]
	var start_abs := int(pack.get("start_frame", 0))
	var i0 := maxi(0, from_frame - start_abs)
	var i1 := mini(col.size() - 1, to_frame - start_abs)
	if i1 < i0:
		return PackedFloat64Array()
	return col.slice(i0, i1 + 1)


static func _env_section(pack: Dictionary) -> String:
	var m: Dictionary = pack.get("manifest", {})
	var engine: Dictionary = m.get("engine", {})
	var env: Dictionary = m.get("env", {})
	var pre: Dictionary = m.get("measure_preconditions", {})
	var rows := [
		["引擎", String(engine.get("version", "?"))],
		["渲染器 / 驱动", "%s / %s" % [engine.get("renderer", "?"), engine.get("driver", "?")]],
		["物理", String(engine.get("physics", "?"))],
		["GPU", String(env.get("gpu", "?"))],
		["OS", "%s %s" % [env.get("os", "?"), env.get("os_version", "")]],
		["v-sync / max_fps", "%s / %s" % [pre.get("vsync", "?"), pre.get("max_fps", "?")]],
		["settings_hash", String(m.get("settings_hash", "?"))],
	]
	var out := PackedStringArray()
	out.append("## 环境")
	out.append("")
	out.append("| 项 | 值 |")
	out.append("| --- | --- |")
	for r in rows:
		out.append("| %s | %s |" % [r[0], r[1]])
	out.append("")
	return "\n".join(out)


static func _diag_section(pack: Dictionary) -> String:
	var m: Dictionary = pack.get("manifest", {})
	var diag: Dictionary = m.get("diagnostics", {})
	var unavailable: Dictionary = diag.get("unavailable_columns", {})
	var degradations: Array = m.get("capture", {}).get("degradations", [])
	var out := PackedStringArray()
	out.append("## 数据完整性诊断")
	out.append("")
	if unavailable.is_empty() and degradations.is_empty():
		out.append("本次采集所有数据源均可用，没有降级。")
		out.append("")
		return "\n".join(out)
	for col_name in unavailable:
		out.append("- 列 `%s` 不可用：%s" % [col_name, unavailable[col_name]])
	for d in degradations:
		out.append("- 采集期间降级：%s" % String(d))
	out.append("")
	return "\n".join(out)
